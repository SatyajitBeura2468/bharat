{
  "name": "bharat-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "BHARAT — a cinematic, interactive and evidence-led digital atlas of India.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node scripts/run-eslint.cjs",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:sources": "tsx scripts/validate-sources.ts",
    "check:links": "tsx scripts/check-links.ts",
    "qa": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:content && pnpm validate:sources && pnpm check:links && pnpm build"
  },
  "dependencies": {
    "@next/mdx": "^16.2.12",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^6.0.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
